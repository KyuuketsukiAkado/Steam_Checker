{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "steam-wrapped-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,

  // The API key is intentionally absent. Add it in Cloudflare as the
  // STEAM_API_KEY Secret — never in this file or a .dev.vars file committed to Git.
  "vars": {
    "API_ENABLED": "true",
    "DAILY_STEAM_CALL_LIMIT": "900"
  },

  "kv_namespaces": [
    {
      "binding": "STEAM_CACHE",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-rate-limiter",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}
